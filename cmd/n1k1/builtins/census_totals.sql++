-- label:       census_totals.sql++
-- version:     v1.1
-- description: per-record-type totals — census.sql++'s coverage denominator
-- param: keyspace ident
-- param: type_field ident = type

-- Companion to census.sql++: coverage = census.docs / totals.n per record type,
-- computed at READ time (a stored ratio wouldn't merge; the numerator and
-- denominator each do).
SELECT IFMISSING(r.[$type_field], "") AS rt, COUNT(*) AS n
FROM $keyspace r
GROUP BY IFMISSING(r.[$type_field], "")
